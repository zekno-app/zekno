{
  "name": "@workspace/cli",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "license": "MIT",
  "bin": {
    "zekno": "./src/main.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint --max-warnings 0",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "test": "bun test",
    "compile": "bun build.ts",
    "test:e2e": "E2E_TELEMETRY_DISABLED=1 DO_NOT_TRACK=1 bun --bun --env-file=.env.local e2e run --exclude-tag docker",
    "test:e2e:docker": "E2E_TELEMETRY_DISABLED=1 DO_NOT_TRACK=1 ZEKNO_E2E_REAL_DOCKER=1 bun --bun --env-file=.env.local e2e run --tag docker"
  },
  "dependencies": {
    "@workspace/core": "workspace:*",
    "ink": "8.0.0",
    "react": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/react": "19.3.0",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "ai": "^7",
    "e2e": "0.23.1",
    "eslint": "^10",
    "typescript": "^5"
  }
}
